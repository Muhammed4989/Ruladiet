{"content":"\u003cdiv class=\"rula-page\"\u003e\n\u003csection class=\"hero\" id=\"hero\"\u003e\n\u003cdiv class=\"hero-bg\"\u003e\n                \u003cpicture\u003e\u003csource srcset=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/ruladiet1.webp\" type=\"image/webp\"\u003e\u003cimg decoding=\"async\" src=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/ruladiet1.webp\" alt=\"رولا علوش - اختصاصية التغذية\" title=\"رولا علوش - اختصاصية التغذية\" width=\"1200\" height=\"675\" loading=\"eager\" fetchpriority=\"high\"\u003e\n                \u003c/picture\u003e\n            \u003c/div\u003e\n\u003cdiv class=\"hero-wrapper\"\u003e\n\u003cdiv class=\"hero-content\"\u003e\n\u003cdiv class=\"hero-text-col hero-text--right\"\u003e\n                        \u003cspan class=\"hero-subtitle\"\u003eالحياة الصحية سهلة\u003c/span\u003e\u003c/p\u003e\n\u003ch1 class=\"hero-title\"\u003eاختصاصية التغذية\u003cbr /\u003e\u003cspan class=\"highlight\"\u003eرولا علوش\u003c/span\u003e\u003c/h1\u003e\n\u003cp class=\"hero-text\"\u003eرولا دايت هو المكان الذي ستحقق فيه غاياتك الصحية وجسدك الرشيق\u003c/p\u003e\n\u003cdiv class=\"hero-actions\"\u003e\n                            \u003ca href=\"/appointment\" class=\"btn btn-primary btn-lg\"\u003eاحجز استشارتك الآن\u003c/a\u003e\u003cbr /\u003e\n                            \u003ca href=\"https://wa.me/905300222468?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%AD%D8%AC%D8%B2%20%D8%A7%D8%B3%D8%AA%D8%B4%D8%A7%D8%B1%D8%A9\" class=\"btn btn-outline btn-lg\" target=\"_blank\" rel=\"noopener\"\u003eواتساب\u003c/a\u003e\u003cbr /\u003e\n                            \u003ca href=\"/courses\" class=\"btn btn-outline btn-lg\"\u003eتصفح الدورات\u003c/a\u003e\n                        \u003c/div\u003e\n\u003cdiv class=\"hero-stats\"\u003e\n\u003cdiv class=\"stat\"\u003e\n                                \u003cspan class=\"stat-number\"\u003e+140K\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"stat-label\"\u003eمتابع على انستغرام\u003c/span\u003e\n                            \u003c/div\u003e\n\u003cdiv class=\"stat\"\u003e\n                                \u003cspan class=\"stat-number\"\u003e4.9\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"stat-label\"\u003eتقييم جوجل (153 تقييم)\u003c/span\u003e\n                            \u003c/div\u003e\n\u003cdiv class=\"stat\"\u003e\n                                \u003cspan class=\"stat-number\"\u003e+570\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"stat-label\"\u003eطالب في الدورات\u003c/span\u003e\n                            \u003c/div\u003e\n\u003cdiv class=\"stat\"\u003e\n                                \u003cspan class=\"stat-number\"\u003e+4000\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"stat-label\"\u003eشخص وصل للوزن المثالي\u003c/span\u003e\n                            \u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\n\u003cdiv class=\"hero-wave\"\u003e\n                \u003csvg viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\"\u003e\n                    \u003cpath d=\"M0,0 L1440,0 L1440,120 L0,120 Z\" class=\"wave-green\"/\u003e\n                    \u003cpath d=\"M0,50 C200,100 400,20 600,50 C800,80 1000,15 1200,50 C1320,72 1380,30 1440,50 L1440,120 L0,120 Z\" class=\"wave-white\"/\u003e\n                \u003c/svg\u003e\n            \u003c/div\u003e\n\u003c/section\u003e\n\u003csection class=\"courses-section\" id=\"courses\"\u003e\n\u003cdiv class=\"container\"\u003e\n\u003cdiv class=\"section-header\"\u003e\n                    \u003cspan class=\"section-badge\"\u003eدوراتنا\u003c/span\u003e\u003c/p\u003e\n\u003ch2 class=\"section-title\"\u003eبرامج متخصصة لتحقيق أهدافك\u003c/h2\u003e\n\u003c/p\u003e\u003c/div\u003e\n\u003cdiv class=\"courses-wrapper\"\u003e\n                    \u003cbutton class=\"scroll-btn scroll-btn--left\" id=\"scrollLeft\" aria-label=\"السابق\"\u003e\u0026#8592;\u003c/button\u003e\u003cbr /\u003e\n                    \u003cbutton class=\"scroll-btn scroll-btn--right\" id=\"scrollRight\" aria-label=\"التالي\"\u003e\u0026#8594;\u003c/button\u003e\u003c/p\u003e\n\u003cdiv class=\"courses-grid\" id=\"coursesGrid\"\u003e\n                        \u003ca href=\"https://courses.ruladiet.com\" class=\"course-card\" target=\"_blank\" rel=\"noopener\"\u003e\u003c/p\u003e\n\u003cdiv class=\"course-image\"\u003e\n                            \u003cimg decoding=\"async\" src=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/course1.webp\" alt=\"كورس التعافي من الشهية الانفعالية\" title=\"كورس التعافي من الشهية الانفعالية\" loading=\"lazy\" width=\"400\" height=\"270\"\u003e\n                        \u003c/div\u003e\n\u003cdiv class=\"course-body\"\u003e\n\u003cdiv class=\"course-price\"\u003e\n                                \u003cspan class=\"price-current\"\u003e$200.00\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"price-old\"\u003e$249.00\u003c/span\u003e\n                            \u003c/div\u003e\n\u003ch3 class=\"course-title\"\u003eكورس التعافي من الشهية الانفعالية\u003c/h3\u003e\n\u003cdiv class=\"course-meta\"\u003e\n                                \u003cspan class=\"course-students\"\u003e140 طالب\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"course-category\"\u003eالتعافي\u003c/span\u003e\n                            \u003c/div\u003e\u003c/div\u003e\n\u003cp\u003e                    \u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e                    \u003ca href=\"https://courses.ruladiet.com\" class=\"course-card\" target=\"_blank\" rel=\"noopener\"\u003e\u003c/p\u003e\n\u003cdiv class=\"course-image\"\u003e\n                            \u003cimg decoding=\"async\" src=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/course2.webp\" alt=\"كورس رحلة التغيير المجاني\" title=\"كورس رحلة التغيير المجاني\" loading=\"lazy\" width=\"400\" height=\"270\"\u003e\n                        \u003c/div\u003e\n\u003cdiv class=\"course-body\"\u003e\n\u003cdiv class=\"course-price\"\u003e\n                                \u003cspan class=\"price-free\"\u003eمجاناً\u003c/span\u003e\n                            \u003c/div\u003e\n\u003ch3 class=\"course-title\"\u003eكورس رحلة التغيير \u003cspan class=\"badge-free\"\u003e( المجاني )\u003c/span\u003e\u003c/h3\u003e\n\u003cdiv class=\"course-meta\"\u003e\n                                \u003cspan class=\"course-students\"\u003e211 طالب\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"course-duration\"\u003e27 دقيقة\u003c/span\u003e\n                            \u003c/div\u003e\u003c/div\u003e\n\u003cp\u003e                    \u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e                    \u003ca href=\"https://courses.ruladiet.com\" class=\"course-card\" target=\"_blank\" rel=\"noopener\"\u003e\u003c/p\u003e\n\u003cdiv class=\"course-image\"\u003e\n                            \u003cimg decoding=\"async\" src=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/course3.webp\" alt=\"كورس المسار الصحي\" title=\"كورس المسار الصحي\" loading=\"lazy\" width=\"400\" height=\"270\"\u003e\n                        \u003c/div\u003e\n\u003cdiv class=\"course-body\"\u003e\n\u003cdiv class=\"course-price\"\u003e\n                                \u003cspan class=\"price-current\"\u003e$247.00\u003c/span\u003e\n                            \u003c/div\u003e\n\u003ch3 class=\"course-title\"\u003eكورس المسار الصحي\u003c/h3\u003e\n\u003cdiv class=\"course-meta\"\u003e\n                                \u003cspan class=\"course-students\"\u003e215 طالب\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"course-duration\"\u003e2 ساعة 53 دقيقة\u003c/span\u003e\n                            \u003c/div\u003e\u003c/div\u003e\n\u003cp\u003e                    \u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e                    \u003ca href=\"https://courses.ruladiet.com\" class=\"course-card\" target=\"_blank\" rel=\"noopener\"\u003e\u003c/p\u003e\n\u003cdiv class=\"course-image\"\u003e\n                            \u003cimg decoding=\"async\" src=\"https://wordpress-733947-6451423.cloudwaysapps.com/wp-content/uploads/2026/05/course4.webp\" alt=\"كورس التعافي من تكيس المبايض\" title=\"كورس التعافي من تكيس المبايض\" loading=\"lazy\" width=\"400\" height=\"270\"\u003e\n                        \u003c/div\u003e\n\u003cdiv class=\"course-body\"\u003e\n\u003cdiv class=\"course-price\"\u003e\n                                \u003cspan class=\"price-current\"\u003e$247.00\u003c/span\u003e\n                            \u003c/div\u003e\n\u003cdiv class=\"course-rating\"\u003e\n                                \u003cspan class=\"stars\"\u003e★★★★★\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"rating-text\"\u003e5.00 (1 تقييم)\u003c/span\u003e\n                            \u003c/div\u003e\n\u003ch3 class=\"course-title\"\u003eكورس التعافي من تكيس المبايض\u003c/h3\u003e\n\u003cdiv class=\"course-meta\"\u003e\n                                \u003cspan class=\"course-students\"\u003e13 طالب\u003c/span\u003e\u003cbr /\u003e\n                                \u003cspan class=\"course-duration\"\u003e2 ساعة\u003c/span\u003e\n                            \u003c/div\u003e\u003c/div\u003e\n\u003cp\u003e                    \u003c/a\u003e\n                \u003c/div\u003e\u003c/div\u003e\n\u003cdiv class=\"section-cta\"\u003e\n                \u003ca href=\"https://courses.ruladiet.com\" class=\"btn btn-outline\" target=\"_blank\" rel=\"noopener\"\u003eتصفح جميع الدورات\u003c/a\u003e\n            \u003c/div\u003e\u003c/div\u003e\n\u003c/section\u003e\n\u003cdiv class=\"section-wave\"\u003e\n            \u003csvg viewBox=\"0 0 1440 100\" preserveAspectRatio=\"none\"\u003e\n                \u003cpath d=\"M0,0 L1440,0 L1440,100 L0,100 Z\" class=\"wave-green\"/\u003e\n                \u003cpath d=\"M0,40 C200,85 400,15 600,40 C800,65 1000,10 1200,40 C1320,58 1380,25 1440,40 L1440,100 L0,100 Z\" class=\"wave-white\"/\u003e\n            \u003c/svg\u003e\n        \u003c/div\u003e\n\u003csection class=\"bmi-section\" id=\"bmi\"\u003e\n\u003cdiv class=\"bmi-container\"\u003e\n\u003cdiv class=\"bmi-grid\"\u003e\n\u003cdiv class=\"bmi-left\"\u003e\n\u003cdiv class=\"about-mini\"\u003e\n                            \u003cspan class=\"section-badge\"\u003eتعرف علينا\u003c/span\u003e\u003c/p\u003e\n\u003ch2 class=\"section-title\"\u003eعن رولا\u003c/h2\u003e\n\u003cdiv class=\"about-mini-content\"\u003e\n\u003cdiv class=\"about-mini-text\"\u003e\n\u003ch3\u003eاختصاصية التغذية رولا علوش\u003c/h3\u003e\n\u003cul class=\"credentials credentials-mini\"\u003e\n\u003cli\u003eبكالوريوس هندسة غذائية \u0026#8211; Istanbul Aydin University\u003c/li\u003e\n\u003cli\u003eبكالوريوس تغذية وحميات \u0026#8211; Sabahattin Zaim\u003c/li\u003e\n\u003cli\u003eماستر تغذية الطعام \u0026#8211; Sabahattin Zaim\u003c/li\u003e\n\u003cli\u003eتدير عيادة التغذية في اسطنبول / تركيا\u003c/li\u003e\n\u003c/ul\u003e\u003c/div\u003e\n\u003cdiv class=\"about-mini-image\"\u003e\n                                    \u003cimg decoding=\"async\" src=\"https://ruladiet.com/wp-content/uploads/2025/05/Untitled-design-2-1.svg\" alt=\"رولا علوش - اختصاصية التغذية\" loading=\"lazy\"\u003e\n                                \u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\n\u003cdiv class=\"bmi-right\"\u003e\n\u003cdiv class=\"bmi-card\"\u003e\n\u003cdiv class=\"bmi-card-inner\"\u003e\n                                \u003cspan class=\"bmi-label\"\u003e\u003cbr /\u003e\n                                    \u003csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\u003e\u003cpath d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/\u003e\u003c/svg\u003e\u003cbr /\u003e\n                                    حاسبة صحية\u003cbr /\u003e\n                                \u003c/span\u003e\u003c/p\u003e\n\u003ch2 class=\"bmi-title\"\u003eاحسب مؤشر كتلة الجسم (BMI)\u003c/h2\u003e\n\u003cdiv class=\"bmi-form\"\u003e\n\u003cdiv class=\"form-group\"\u003e\n                                        \u003clabel for=\"weight\"\u003eالوزن (كجم)\u003c/label\u003e\u003cbr /\u003e\n                                        \u003cinput type=\"number\" id=\"weight\" placeholder=\"100\" min=\"1\" step=\"0.1\" inputmode=\"decimal\" value=\"\"\u003e\n                                    \u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n                                        \u003clabel for=\"height\"\u003eالطول (سم)\u003c/label\u003e\u003cbr /\u003e\n                                        \u003cinput type=\"number\" id=\"height\" placeholder=\"180\" min=\"1\" step=\"1\" inputmode=\"decimal\" value=\"\"\u003e\n                                    \u003c/div\u003e\u003c/div\u003e\n\u003cp class=\"bmi-helper\"\u003eيمكن استخدام الفاصلة او النقطة: 52.5\u003c/p\u003e\n\u003cdiv class=\"bmi-result\" id=\"bmiResult\"\u003e\n\u003cdiv class=\"result-header\"\u003e\n\u003cdiv class=\"result-value\"\u003e\n                                            \u003cspan class=\"result-label\"\u003eالنتيجة\u003c/span\u003e\u003cbr /\u003e\n                                            \u003cspan class=\"result-number\" id=\"bmiValue\"\u003e\u0026#8212;\u003c/span\u003e\n                                        \u003c/div\u003e\n\u003cdiv class=\"result-class\"\u003e\n                                            \u003cspan class=\"result-label\"\u003eالتصنيف\u003c/span\u003e\u003cbr /\u003e\n                                            \u003cspan class=\"result-badge\" id=\"bmiCategory\"\u003e—\u003c/span\u003e\n                                        \u